# Normalise line endings in the repository, so a checkout on Windows and a CI run on
# Linux do not produce a diff in every file that was merely opened. Applied as files
# are touched rather than by a bulk renormalisation, which would bury real changes.
* text=auto eol=lf

# Windows-only, and PowerShell is happier with CRLF on disk.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touched.
*.png binary
*.jpg binary
*.ico binary
*.xlsx binary
*.pptx binary
