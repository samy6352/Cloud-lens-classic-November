# Copy to .env and fill in. Nothing here is secret: CloudLens signs in as a public
# client with PKCE and reads Azure with a managed identity, so there is no client
# secret to store. `.env` itself is gitignored regardless.
#
# Only PROJECT_ENDPOINT is required. Everything else has a working default.

# ---------------------------------------------------------------- AI (required)
# The Foundry project the agent talks to. The app refuses to start without it.
# infra/deploy.ps1 prints this value when it finishes.
PROJECT_ENDPOINT=https://<account>.cognitiveservices.azure.com/api/projects/<project>
MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# ---------------------------------------------------------------- sign-in
# Leave AUTH_CLIENT_ID unset to run with a local password instead of Entra; the
# generated password is printed once into the log on first start.
#AUTH_CLIENT_ID=<app registration client id>
#AUTH_TENANT_ID=<tenant id, or "organizations" for any work account>
#AUTH_REDIRECT_URI=http://localhost:8100/auth/callback
#AUTH_ADMINS=you@example.com

# Each person sees the subscriptions their own Azure access allows. Needs a one-time
# tenant admin consent for ARM user_impersonation; set to false if that is refused,
# and the app falls back to what its own identity can read.
#AUTH_DELEGATED_ARM=true

# ---------------------------------------------------------------- warehouse
# The warehouse is Azure Database for PostgreSQL Flexible Server, and nothing else.
# PGHOST is required: the app refuses to start without it rather than quietly
# falling back to something local, because there is no correct guess for where a
# customer's cost data lives.
#
# No password. The app authenticates with its managed identity, or with your
# az login locally. Set PGPASSWORD only for a server that has password auth on.
#PGHOST=<server>.postgres.database.azure.com
#PGDATABASE=cloudlens
#PGUSER=<managed identity name>
#PGSSLMODE=require

# An optional schema to hold the warehouse, instead of `public`. Lets one server
# carry more than one environment without either overwriting the other.
#PGSCHEMA=cloudlens

# How much memory one sort or hash node may use before it spills to disk. Unset means
# the server's own value, which is the right answer unless you have measured otherwise.
#
# Charged PER NODE, not per query or per connection: a query with three sorts can take
# three times this, and up to PG_POOL_SIZE connections can be doing that at once. Size it
# against the server's memory, not against one query.
#
# Worth setting where the dashboard reads a large derived table. On a 2.78M-row
# resource_presence the top-resources query sorts about 508,000 groups and needs roughly
# 90MB; below that it spills to temp files and pays for it on every request.
#PG_WORK_MEM=128MB

# How long a dashboard read may run on the server before PostgreSQL cancels it.
#
# Set this. An application timeout cannot stop a database query: the await is
# cancelled, but the worker thread, the pooled connection and the query itself keep
# going, and the pool slot is never returned. Once enough slots leak that way every
# request fails on a busy pool, which looks like an outage and is really a leak.
#
# Keep it below the caller's own timeout -- the snapshot cache gives an origin build
# 120s -- so the server ends the query while the request is still waiting for it.
# Applied to readers only; the rollup and presence rebuilds run for several minutes
# and are not subject to it. A bare number is milliseconds.
#PG_STATEMENT_TIMEOUT=110s

# What this instance calls itself in `pg_stat_activity`. Defaults to `cloudlens`.
#
# Worth setting whenever more than one instance shares a database -- a staging
# copy, a probe, a second replica. Without it every backend carries the same name
# and the view cannot say which application caused which query: profiling once
# attributed 56.5s of an endpoint to a statement a different instance was running,
# and the conclusion drawn from it was wrong.
#PG_APPLICATION_NAME=cloudlens

# ---------------------------------------------------------------- cache and diagnostics
# Durable private snapshots are kept in the configured PostgreSQL schema.
# Auth, current scope and calculation versions are checked before every cache hit.
#SNAPSHOT_CACHE_ENABLED=true
# Optional workload identity metadata for permission diagnostics; these grant no access.
#CLOUDLENS_PRINCIPAL_ID=<managed identity object id, not its client id>
#CLOUDLENS_TENANT_ID=<managed identity tenant id>
# Use only on an isolated staging/restore environment. Auth remains required.
#CLOUDLENS_READ_ONLY=true

# ---------------------------------------------------------------- tests
# See tests/README.md. The suite runs against a real PostgreSQL server, so both of
# these are needed for anything but a collection-only run.
#CLOUDLENS_PG_TEST=<host>
#CLOUDLENS_PG_USER=<role to connect as>
#CLOUDLENS_PG_DB=postgres
#CLOUDLENS_AZURE_TEST=1
#CLOUDLENS_TEST_SUBSCRIPTION=<subscription with tagged resources>
